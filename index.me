  const select = document.getElementById("scriptSelector");
  const selectedScriptName = select.options[select.selectedIndex].value;
  language = selectedScriptName;

  if (selectedScriptName) {
   
    typingText.innerHTML = "";

    TT_startbtn.style.display = 'none';
        document.getElementById("TP_O_preload").style.display = "block";

    loadScript(selectedScriptName);
    setTimeout(resetGame, 5000);
  }
};

async function makeApiRequest() {
  const apiUrl = `https://justcount.typingpoint.com/?api_key&language=${language}`;

  try {
    const response = await fetch(apiUrl);
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status}`);
    }

    const data = await response.json();
    console.log(data);
  } catch (error) {
    console.error('API request failed:', error);
  }
}

function secondsToTimeFormat(seconds = 0) {
  if (typeof seconds !== 'number') {
    return "Invalid input. Please provide a number of seconds.";
  }

  const minutes = Math.floor(seconds / 60);
  const remainingSeconds = seconds % 60;
  const formattedMinutes = String(minutes).padStart(2, '0');
  const formattedSeconds = String(remainingSeconds).padStart(2, '0');

  return formattedMinutes + ":" + formattedSeconds;
}

const loadParagraph = () => {
  
      backspaceCount = 0;
  const ranIndex = Math.floor(Math.random() * quote.length);
  const fullText = quote[ranIndex];
  typingText.innerHTML = fullText;
  
  TT_startbtn.style.display = 'block';
  if (TT_text.classList.contains('active')) {
    TT_text.classList.remove('active');
    }
  document.getElementById("TP_O_preload").style.display = "none";
  TT_startbtn.addEventListener("click", () => {
    convertToSpans(typingText, fullText);
    TT_startbtn.style.display = 'none';
    if (!TT_text.classList.contains('active')) {
      TT_text.classList.add('active');
    }
    inpField.focus();
  });
};

const convertToSpans = (element, text) => {
  element.innerHTML = text.split("").map(char => `<span>${char}</span>`).join("");
  element.querySelector("span:first-child").classList.add("active");
};


const initTyping = () => {
  const characters = typingText.querySelectorAll("span");
  const typedChar = inpField.value.split("")[charIndex];

  if (charIndex < characters.length - 1 && timeLeftTP > 0) {
    if (!isTyping) {
      timerTP = setInterval(initTimer, 1000);
      isTyping = true;
    }

    if (typedChar == null) {
      if (charIndex > 0) {
        charIndex--;
        if (characters[charIndex].classList.contains("incorrect")) {
          mistakes--;
        }
        characters[charIndex].classList.remove("correct", "incorrect");
      }
    } else {
      if (characters[charIndex].innerText == typedChar) {
        characters[charIndex].classList.add("correct");
      } else {
        mistakes++;
        characters[charIndex].classList.add("incorrect");
      }
      charIndex++;
    }

    characters.forEach(span => span.classList.remove("active"));
    characters[charIndex].classList.add("active");

    let totalWords = (charIndex - mistakes) / 5;
    let usedtime = (maxTime - timeLeftTP);
    let minutes = (maxTime - timeLeftTP) / 60;
    let calculatedWPM = Math.round(totalWords / minutes);
    let totalCharactersTyped = charIndex - mistakes;
    let accuracy = (totalCharactersTyped / charIndex) * 100;
    accuracy = isNaN(accuracy) ? 0 : Math.round(accuracy);
    TP_O_Accuracy.innerHTML = accuracy + "%";

    wpmTag.innerHTML = calculatedWPM;
    mistakeTag.innerHTML = mistakes;
    cpmTag.innerHTML = charIndex - mistakes;

    TP_O_Time.innerHTML = secondsToTimeFormat(usedtime);
    TP_O_Speed.innerHTML = calculatedWPM;
    TP_O_Backspace.innerHTML = backspaceCount;
    TP_O_Mistake.innerHTML = mistakes;
  } else {
    main_TPinput.style.display = "none";
    main_TPoutput.style.display = "block";
    makeApiRequest();
    clearInterval(timerTP);
    inpField.value = "";
  }
};

const initTimer = () => {
  if (timeLeftTP > 0) {
    timeLeftTP--;
    timeTag.innerText = `${timeLeftTP}s`;
    const wpm = Math.round(((charIndex - mistakes) / 5) / (maxTime - timeLeftTP) * 60);
    wpmTag.innerText = wpm;
  } else {
    clearInterval(timerTP);
  }
};

const resetGame = () => {
  loadParagraph();
  clearInterval(timerTP);
  timeLeftTP = maxTime;
  charIndex = 0;
  mistakes = 0;
  isTyping = false;
  inpField.value = "";
  timeTag.innerText = `${timeLeftTP}s`;
  wpmTag.innerText = "0";
  mistakeTag.innerText = "0";
  cpmTag.innerText = "0";
};

const resetTPGame = () => {
  main_TPinput.style.display = "block";
  main_TPoutput.style.display = "none";
  resetGame();
};

const secButtons = document.querySelectorAll('.secbtn');

secButtons.forEach(button => {
  button.onclick = function () {
    typingText.innerHTML = "";
    document.getElementById("TP_O_preload").style.display = "block";
    secButtons.forEach(btn => {
      btn.classList.remove('secactive');
    });
    maxTime = parseInt(this.id);
    button.classList.add('secactive');
    resetGame();
  };
});

setTimeout(loadParagraph, 3000);
inpField.addEventListener("input", initTyping);
tryAgainBtn.addEventListener("click", resetGame);
TPnew_rst_btn.addEventListener("click", resetTPGame);

inpField.addEventListener("keydown", (event) => {
  if (event.key === "Backspace" || event.keyCode === 8) {
    backspaceCount++;
  }
});

document.addEventListener('DOMContentLoaded', function () {
   btn.onclick = () => {
    const formData = new FormData(document.getElementById('ratingForm'));

    fetch('https://www.typingpoint.com/api/rating.cshtml', {
      method: 'POST',
      body: formData
    })
      .then(response => {
        if (!response.ok) {
          throw new Error('Network response was not ok');
        }
        return response.json();
      })
      .then(data => {
        if (data.success) {
          // Assume language is defined somewhere
          ratedData[`${language}_Is_rated`] = true;
          localStorage.setItem('ratedata', JSON.stringify(ratedData));

          widget.style.display = "none";
          post.style.display = "block";

          editBtn.onclick = () => {
            widget.style.display = "block";
            post.style.display = "none";
          };
        } else {
          console.error('Error: Invalid JSON response');
        }
      })
      .catch(error => {
        console.error('Error:', error.message);
      });

    return false;
  };

  var ratingInputs = document.querySelectorAll('input[name="rate"]');
  ratingInputs.forEach(input => {
    input.addEventListener('change', function () {
      document.getElementById('selectedRating').value = this.value;
    });
  });
});

  
</script>
